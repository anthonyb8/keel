#!/usr/bin/env bash
# keel: the front door to sessions that run on keel's rules and rails.
#
#   keel claude [args]        run claude on keel's config dir, ~/.keel/claude
#   keel pack [dir]           print the pack that owns dir (default: the current directory)
#   keel base [dir]           print the base branch that pack names, if any
#   keel protected [dir]      print the branches no session may move: the base, the default
#                             branch and the pack's `protected` list
#   keel provision [dir]      prepare a fresh worktree: the pack's provision script, else the default
#   keel sweep [--apply]      return idle keel-leased trees in this repo's pool that hold no work,
#                             and release the stacks of trees already returned
#   keel gate "<intent>"      run the no-mistakes gate on this branch; --dry-run prints the command
#   keel fold <fix> <target>  fold a gate fix commit into the commit it fixes, for unpushed
#                             history only; refused or undone unless the final tree is unchanged
#   keel linear <verb> ...    Linear for this repository's workspace, over its API:
#                               team                      the team key
#                               get <ID>                  the issue, its relations and comments, as JSON
#                               search <text>             the team's open issues whose title has the text
#                               create --title <t> --body <file> [--project <name>] [--blocked-by <ID>]...
#                               update <ID> [--state <name>] [--body <file>]
#                               comment <ID> --body <file>
#                               relate <A> blocks <B>
#                               project create|get|update <name> [--summary <s>] [--body <file>]
#   keel template [name] [dir]
#                             print the issue or project template that applies in dir; no name lists them
#   keel run start --playbook <name> --goal <text> --steps <file> [--replace]
#                             start a run in this tree, recorded under ~/.local/state/keel/runs
#   keel run step <n> doing|done|skip <reason>
#   keel run pause            pause the run; a resume note on stdin goes into its folder
#   keel run decide "<decision>" --why <text> --evidence <ref> [--result <text>] [--attention]
#                             log a decision to the run's decisions.tsv
#   keel run stop done|stopped|failed [--note <text>] [--tree <path>]
#                             end the run and archive it
#   keel status --json [path] every run not yet archived, or the one for path; docs/status.md
#   keel reflect triage [session] < findings.json
#                             /reflect's twice rule and level order: accepted, held and rejected
#   keel stack up [args]      start this tree's stack detached through the pack's stack script,
#                             wait until it serves, print its URL; args go to the script
#   keel stack down           stop it
#   keel stack release        free what the stack keeps after down, such as its database
#   keel stack status         print its URL when it is running, fail when it is not
#   keel e2e [-e NAME=VALUE]... [command...]
#                             run command (default: npx playwright test) in the Playwright image,
#                             on no network but this tree's stack ports, relayed in through Unix sockets
#   keel hook <name>          Claude Code hook entry point, event JSON on stdin:
#                               context          SessionStart (the router and pack rules) and
#                                                SubagentStart (pack rules only)
#                               worktree-create  WorktreeCreate
#                               worktree-remove  WorktreeRemove
#                               subagent-stop    SubagentStop
#                               git-guard        PreToolUse on Bash
#                               stop             Stop: holds a contracted run's turn until its done check passes
#   keel help                 print this help
#
# A pack is a directory registered under $KEEL_PACKS (default
# ~/.config/harness/packs, read-only), shared with harness until packs move
# into their repositories.
# shellcheck disable=SC2016 # keel linear's GraphQL documents hold literal $variables
set -euo pipefail

# The config dir is set by `keel claude` and nowhere else: Claude Code ignores
# CLAUDE_CONFIG_DIR in project and local settings, and setting it in the shell
# would move every plain `claude` off harness too.
#
# Trees keel leases are held as keel:<branch> and keel:agent-<id>, never
# harness's claude:, so neither system's sweep or stop hook can return a tree
# the other holds.

PACKS_DIR="${KEEL_PACKS:-$HOME/.config/harness/packs}"
LIB_DIR="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")/lib"
KEEL_ROOT="$(dirname "$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")")"
METHOD_DIR="$KEEL_ROOT/method"
TEMPLATES_DIR="$KEEL_ROOT/templates"
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
KEEP_FILE="${KEEL_KEEP:-$HOME/.config/keel/keep}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/keel"
RUNS_DIR="$STATE_DIR/runs"
STALE_FILE="$STATE_DIR/stale"

die() {
  echo "keel: $*" >&2
  exit 1
}

usage() {
  awk 'NR>1 && /^# shellcheck/ {next} NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "$0"
}

# Prints the pack whose `match` file has a glob matching the origin remote of
# the repository at $1, or nothing when no pack claims it. Keyed on the remote
# rather than the path, so every worktree and every clone of a repository
# resolves to the same pack without a file in any of them.
pack_for() {
  local dir="$1" remote pack pattern
  remote=$(git -C "$dir" remote get-url origin 2>/dev/null) || return 0
  for pack in "$PACKS_DIR"/*/; do
    [[ -f "$pack/match" ]] || continue
    while IFS= read -r pattern || [[ -n "$pattern" ]]; do
      [[ -z "$pattern" || "$pattern" == \#* ]] && continue
      # shellcheck disable=SC2053 # the pattern is a glob on purpose
      if [[ "$remote" == $pattern ]]; then
        echo "${pack%/}"
        return 0
      fi
    done <"$pack/match"
  done
}

# A pack covers several repositories and not every one has the pack's base, so
# a repository without it keeps its own default rather than failing to lease.
base_for() {
  local pack base
  pack=$(pack_for "$1")
  [[ -n "$pack" && -f "$pack/base" ]] || return 0
  base=$(tr -d '[:space:]' <"$pack/base")
  if git -C "$1" rev-parse --verify --quiet "refs/remotes/origin/$base" >/dev/null; then
    echo "$base"
  fi
}

# The base is protected only where the repository has it, like base_for. A
# clone with no origin/HEAD cannot say which branch is the default, so main and
# master both count rather than neither.
protected_for() {
  local dir="$1" pack head
  {
    base_for "$dir"
    if head=$(git -C "$dir" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null); then
      echo "${head#origin/}"
    else
      printf 'main\nmaster\n'
    fi
    pack=$(pack_for "$dir")
    if [[ -n "$pack" && -f "$pack/protected" ]]; then
      grep -Ev '^[[:space:]]*(#|$)' "$pack/protected" | tr -d '[:blank:]'
    fi
  } | sort -u
}

# A pack's provision script replaces the default rather than adding to it, so
# a pack never has to undo a step it does not want.
provision() {
  local dir="$1" pack
  pack=$(pack_for "$dir")
  if [[ -n "$pack" && -x "$pack/provision" ]]; then
    (cd "$dir" && "$pack/provision")
    return
  fi
  if [[ -f "$dir/package-lock.json" ]]; then
    npm_ci "$dir"
  fi
}

# A reused pool tree keeps its node_modules, so npm ci runs only when the
# lockfile or Node has changed since the install that wrote the stamp. The
# stamp keeps harness's name, so a tree either one provisioned is not
# reinstalled by the other.
npm_ci() {
  local dir="$1" stamp want
  stamp="$dir/node_modules/.harness-provisioned"
  want="$(node --version) $(sha256sum "$dir/package-lock.json" | cut -d' ' -f1)"
  [[ "$(cat "$stamp" 2>/dev/null)" == "$want" ]] && return 0
  (cd "$dir" && npm ci) && echo "$want" >"$stamp"
}

# Injects keel's router into every main session, and the owning pack's
# rules.md into every session and subagent. Runs for SessionStart, which fires
# on startup, resume, /clear and after compaction, and for SubagentStart,
# because a subagent gets no SessionStart of its own and would otherwise work
# without the rules its parent was given. A subagent gets no router: it carries
# out one step of its parent's playbook, so it is told to follow its brief.
# Packs are shared with harness until row 11, so their rules may name
# `harness <verb>`; the note maps those onto keel.
hook_context() {
  local input event cwd pack context=""
  input=$(cat)
  event=$(jq -r .hook_event_name <<<"$input")
  cwd=$(jq -r .cwd <<<"$input")
  if [[ "$event" == SubagentStart ]]; then
    context="You are a delegate in a keel session: follow your brief and the playbook step it names, and do not route the task or open a playbook of your own."
  else
    context=$(cat "$METHOD_DIR/router.md")
  fi
  pack=$(pack_for "$cwd")
  if [[ -n "$pack" && -f "$pack/rules.md" ]]; then
    context+=$'\n\n'"Rules from the $(basename "$pack") pack, which owns this repository. They hold alongside ~/.keel/claude/CLAUDE.md and win where the two disagree. This is a keel session: where these rules name \`harness <verb>\`, run \`keel <verb>\` instead."$'\n\n'"$(cat "$pack/rules.md")"
  fi
  jq -n --arg event "$event" --arg context "$context" \
    '{hookSpecificOutput: {hookEventName: $event, additionalContext: $context}}'
}

# Replaces Claude Code's own `git worktree add` for EnterWorktree, `claude
# --worktree` and subagents with worktree isolation, so all of them get a
# provisioned pool tree on a named branch instead of a bare checkout. stdout
# carries the path and nothing else; everything treehouse says goes to stderr.
hook_worktree_create() {
  local input name cwd base path
  input=$(cat)
  name=$(jq -r .name <<<"$input")
  cwd=$(jq -r .cwd <<<"$input")
  [[ -n "$name" && "$name" != null ]] || die "WorktreeCreate gave no name"
  # A branch that already has a worktree is that worktree: asking for the same
  # name again resumes it rather than leasing a second tree git would refuse.
  path=$(git -C "$cwd" worktree list --porcelain |
    awk -v ref="branch refs/heads/$name" '/^worktree /{p=substr($0,10)} $0==ref{print p; exit}')
  if [[ -n "$path" ]]; then
    echo "$path"
    return
  fi

  base=$(base_for "$cwd")
  local args=(get --lease --lease-holder "keel:$name")
  [[ -n "$base" ]] && args+=(--base "$base")

  # -b refuses a branch that already exists, so an existing branch with no
  # worktree is leased detached and switched to. A failed switch returns the
  # lease, or the tree stays held by nothing.
  if git -C "$cwd" rev-parse --verify --quiet "refs/heads/$name" >/dev/null; then
    path=$(cd "$cwd" && treehouse "${args[@]}") || die "lease failed (pool exhausted? treehouse status)"
    if ! git -C "$path" switch --quiet "$name" >&2; then
      treehouse return "$path" >&2 || true
      die "could not switch the leased tree to $name"
    fi
  else
    path=$(cd "$cwd" && treehouse "${args[@]}" --branch "$name") || die "lease failed (pool exhausted? treehouse status)"
  fi
  echo "$path"
}

# Prints the treehouse status entry for the pool tree at $1, or nothing when
# the path is not a pool tree.
pool_entry() {
  local top
  top=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) || return 0
  (cd "$top" && treehouse status --json 2>/dev/null) | jq -c --arg p "$top" '.[] | select(.path == $p)'
}

# Returns the pool tree at $1 when it holds nothing worth keeping: no
# uncommitted change and no commit that is not already on a remote. A tree
# with work in it stays leased so the work can be reviewed. The agent-* branch
# of a returned tree is deleted, since by then it points at nothing new.
release_if_empty() {
  local path="$1" branch held
  if held=$(run_holding "$path"); then
    echo "kept $path: run $held" >&2
    return 1
  fi
  if [[ -n "$(git -C "$path" status --porcelain)" ]]; then
    echo "kept $path: uncommitted changes" >&2
    return 1
  fi
  if [[ -z "$(git -C "$path" for-each-ref --contains HEAD --count=1 refs/remotes)" ]]; then
    echo "kept $path: commits not on any remote" >&2
    return 1
  fi
  branch=$(git -C "$path" rev-parse --abbrev-ref HEAD)
  stack_down "$path" >&2
  stack_release "$path"
  treehouse return "$path" >&2
  if [[ "$branch" == agent-* ]]; then
    git -C "$path" branch -D --quiet "$branch" >&2 || true
  fi
  echo "returned $path" >&2
}

# Claude Code does not fire WorktreeRemove for subagent trees, so the tree is
# released when the subagent stops. Only a tree leased for this very subagent
# is touched: a subagent without isolation runs in its parent's tree, which
# must never be returned from under the parent.
hook_subagent_stop() {
  local input agent_id cwd entry
  input=$(cat)
  agent_id=$(jq -r .agent_id <<<"$input")
  cwd=$(jq -r .cwd <<<"$input")
  if [[ "$(jq -r '.agent_type // ""' <<<"$input")" == keel-verifier ]]; then
    record_verdict "$cwd" "$(jq -r '.last_assistant_message // ""' <<<"$input")"
  fi
  entry=$(pool_entry "$cwd")
  [[ -n "$entry" ]] || return 0
  [[ "$(jq -r .lease_holder <<<"$entry")" == "keel:agent-$agent_id" ]] || return 0
  release_if_empty "$(jq -r .path <<<"$entry")" || true
}

# Returns every idle tree keel leased in this repository's pool that holds
# nothing worth keeping, for sessions that ended without a stop hook running.
# Then releases the stack of every tree already back in the pool, since
# `treehouse return` by hand runs no hook and leaves a database behind. A tree
# on the keep list is never touched. Dry run unless --apply.
sweep() {
  local apply=0 entry path held
  [[ "${1:-}" == "--apply" ]] && apply=1
  refresh_stale
  while IFS= read -r entry; do
    path=$(jq -r .path <<<"$entry")
    if is_kept "$path"; then
      echo "kept $path: on the keep list" >&2
    elif held=$(run_holding "$path"); then
      # A stale run is listed but never cleared here: it marks work that
      # stopped mid-step, which `keel run stop stopped --tree` clears by hand.
      echo "kept $path: run $held$(grep -qxF "$path" "$STALE_FILE" 2>/dev/null && echo ", stale")"
    elif [[ "$apply" == 1 ]]; then
      release_if_empty "$path" || true
    else
      echo "would check $path ($(jq -r .lease_holder <<<"$entry"))"
    fi
  done < <(treehouse status --json |
    jq -c '.[] | select(.status == "leased" and (.lease_holder // "" | startswith("keel:")) and (.processes | length == 0))')
  while IFS= read -r path; do
    if is_kept "$path"; then
      echo "kept $path: on the keep list" >&2
    elif [[ "$apply" == 1 ]]; then
      stack_release "$path"
    else
      echo "would release the stack of $path (returned)"
    fi
  done < <(treehouse status --json | jq -r '.[] | select(.status == "available") | .path')
}

is_kept() {
  [[ -f "$KEEP_FILE" ]] && grep -qxF "$1" "$KEEP_FILE"
}

# A tree's stack keeps its pid, log and URL in the worktree's own git dir, which
# git never tracks, so a running stack does not read as work in the tree.
stack_state() {
  local top
  top=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) || die "not a git repository: $1"
  echo "$(git -C "$top" rev-parse --absolute-git-dir)/keel-stack"
}

# The stack runs as the leader of its own session, so its pid is also the
# process group that holds every server it started in the foreground.
stack_alive() {
  local pid
  [[ -f "$1/pid" ]] || return 1
  pid=$(<"$1/pid")
  kill -0 -- "-$pid" 2>/dev/null
}

# Starts the pack's `stack run` under setsid and nohup, so it outlives the
# Claude session and the terminal that started it, and the person can open it
# after the agent has finished. Ready means the pack's `stack url` answers
# HTTP, since a stack that prints its URL can still be minutes from serving.
stack_up() {
  local dir="$1" top pack state url deadline
  shift
  top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || die "not a git repository: $dir"
  pack=$(pack_for "$top")
  [[ -n "$pack" && -x "$pack/stack" ]] || die "no pack with a stack script owns $top"
  state=$(stack_state "$top")
  mkdir -p "$state"

  if stack_alive "$state"; then
    echo "keel: the stack is already running" >&2
  else
    (
      cd "$top"
      setsid nohup "$pack/stack" run "$@" >"$state/log" 2>&1 </dev/null &
      echo $! >"$state/pid"
    )
    rm -f "$state/url"
  fi

  deadline=$((SECONDS + ${KEEL_STACK_TIMEOUT:-900}))
  for (( ; ; )); do
    url=$(cd "$top" && "$pack/stack" url 2>/dev/null) || url=""
    if [[ -n "$url" ]] && curl -s -o /dev/null --max-time 5 "$url"; then
      break
    fi
    if ! stack_alive "$state"; then
      tail -n 40 "$state/log" >&2
      die "the stack exited before it served; full log in $state/log"
    fi
    if ((SECONDS >= deadline)); then
      tail -n 40 "$state/log" >&2
      die "the stack did not serve in time and is still running; log in $state/log, \`keel stack down\` stops it"
    fi
    sleep 2
  done
  echo "$url" >"$state/url"
  echo "$url"
  echo "log: $state/log" >&2
}

# Stops what `stack run` keeps in the foreground. Anything the script detached
# on purpose, such as a local database, stays up like any other local database.
stack_down() {
  local state pid
  # A tree that is already gone has nothing left to stop.
  state=$(stack_state "$1" 2>/dev/null) || return 0
  if stack_alive "$state"; then
    pid=$(<"$state/pid")
    kill -TERM -- "-$pid" 2>/dev/null || true
    for _ in {1..20}; do
      stack_alive "$state" || break
      sleep 0.5
    done
    if stack_alive "$state"; then kill -KILL -- "-$pid" 2>/dev/null || true; fi
    echo "stopped the stack in $(git -C "$1" rev-parse --show-toplevel)"
  fi
  rm -f "$state/pid" "$state/url"
}

# Frees what the pack's stack keeps after `stack down` on purpose, such as a
# local database and its claim on a shared port range, so a tree going back to
# the pool holds nothing. A pack whose stack has no `release` exits 2, which
# means there is nothing to free.
stack_release() {
  local top pack code=0
  top=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) || return 0
  pack=$(pack_for "$top")
  [[ -n "$pack" && -x "$pack/stack" ]] || return 0
  (cd "$top" && "$pack/stack" release) >&2 || code=$?
  case "$code" in
  0) echo "released the stack of $top" >&2 ;;
  2) ;;
  *) echo "keel: releasing the stack of $top failed with $code" >&2 ;;
  esac
}

stack_status() {
  local state
  state=$(stack_state "$1")
  if stack_alive "$state"; then
    echo "running: $(cat "$state/url" 2>/dev/null || echo "starting, not serving yet")"
    echo "log: $state/log"
  else
    echo "stopped"
    return 1
  fi
}

# Runs a command in the Playwright image matching the tree's @playwright/test,
# in a container on `--network none`. The browser on the host's network sees
# every Docker interface come and go and aborts in-flight requests with
# ERR_NETWORK_CHANGED; in a namespace of its own it sees only `lo`. The ports
# the pack's `stack ports` names are relayed in through Unix sockets in a
# directory both sides mount, so the app keeps the URLs it was configured with.
# KEEL_E2E_STACK names another tree whose running stack to drive, so a
# checkout without a stack of its own tests against it without writing there.
e2e() {
  local env=() ports=() top pack port version image name dir code=0
  while [[ "${1:-}" == -e ]]; do
    [[ "${2:-}" == *=* ]] || die "usage: keel e2e [-e NAME=VALUE]... [command...]"
    env+=(-e "$2")
    shift 2
  done
  [[ "${1:-}" == -- ]] && shift
  (($#)) || set -- npx playwright test

  top=$(git rev-parse --show-toplevel 2>/dev/null) || die "not a git repository: $PWD"
  pack=$(pack_for "$top")
  [[ -n "$pack" && -x "$pack/stack" ]] || die "no pack with a stack script owns $top"
  while read -r _ port; do
    [[ "$port" =~ ^[0-9]+$ ]] && ports+=("$port")
  done < <(cd "${KEEL_E2E_STACK:-$top}" && "$pack/stack" ports)
  ((${#ports[@]})) || die "the pack's \`stack ports\` named no ports for ${KEEL_E2E_STACK:-$top}; has its stack started there?"
  version=$(jq -r .version "$top/node_modules/@playwright/test/package.json" 2>/dev/null) ||
    die "no @playwright/test installed in $top"
  image="mcr.microsoft.com/playwright:v$version-noble"

  name="keel-e2e-$$-$RANDOM"
  dir=$(mktemp -d "${TMPDIR:-/tmp}/keel-e2e.XXXXXX")
  # shellcheck disable=SC2064 # expand now: the names are this run's
  trap "docker rm -f '$name' >/dev/null 2>&1 || true; rm -rf '$dir'" EXIT
  node "$LIB_DIR/sockrelay.mjs" host "$dir" "${ports[@]}" -- \
    docker run --rm --name "$name" --network none --ipc=host --init \
    --user "$(id -u):$(id -g)" -e HOME=/tmp "${env[@]}" \
    -v "$top:$top" -v "$dir:/keel/sock" -v "$LIB_DIR:/keel/lib:ro" -w "$PWD" \
    "$image" node /keel/lib/sockrelay.mjs guest /keel/sock "${ports[@]}" -- "$@" || code=$?
  return "$code"
}

hook_worktree_remove() {
  local input path held
  input=$(cat)
  path=$(jq -r '.worktree_path // .path // empty' <<<"$input")
  [[ -n "$path" ]] || die "WorktreeRemove gave no path: $input"
  if held=$(run_holding "$path"); then
    echo "kept $path: run $held" >&2
    return 0
  fi
  stack_down "$path" >&2
  stack_release "$path"
  treehouse return "$path" >&2
}

# Refuses a merge, rebase, cherry-pick or revert that would move a protected
# branch, and in a contracted run anything its grants do not cover;
# lib/git-guard.py says how. Most commands name none of those verbs, so they
# skip Python altogether.
hook_git_guard() {
  local input
  input=$(cat)
  local text cwd
  # Quotes and backslashes go before the match, as the shell would drop them,
  # so `pu''sh` cannot slip past; inside a contracted run every command goes
  # to Python.
  text=$(jq -r '.tool_input.command // empty' <<<"$input" | tr -d "'\"\\\\" | tr '\t' ' ')
  cwd=$(jq -r '.cwd // empty' <<<"$input")
  if ! [[ -n "$cwd" && -f "$(run_dir "$(tree_of "$cwd" 2>/dev/null || echo /nonexistent)")/contract.md" ]]; then
    grep -Eq 'merge|rebase|cherry-pick|revert|commit|update-ref|push|send-pack|branch|tag|gh' <<<"$text" || return 0
  fi
  python3 -I "$LIB_DIR/git-guard.py" "$SELF" <<<"$input"
}

# Runs the no-mistakes gate on the current branch, initialising the repository
# on first use. init writes the no-mistakes remote into the shared .git/config,
# so one init covers every worktree. The PR base comes from the pack, because
# no-mistakes otherwise targets the forge's default branch. Push, PR and CI are
# skipped by default: code leaves the machine only when a push is asked for.
# Rebase is skipped too: the PR itself reports a conflict with its base, and
# rebasing a branch cut from another base, such as a fix straight into staging,
# onto the pack's base would drag that base's unreleased work into it.
gate() {
  local intent="${1:-}" dry=0 base
  [[ -n "$intent" ]] || die 'usage: keel gate "<what you set out to do>" [--dry-run]'
  [[ "${2:-}" == --dry-run ]] && dry=1

  local args=(axi run --intent "$intent" --skip "${KEEL_GATE_SKIP:-rebase,push,pr,ci}")
  base=$(base_for "$PWD")
  [[ -n "$base" ]] && args+=(--base-branch "$base")

  local stale=()
  read -r -a stale <<<"$(stale_gate_copy)" || true
  if [[ "$dry" == 1 ]]; then
    git remote get-url no-mistakes >/dev/null 2>&1 || echo "no-mistakes init"
    [[ ${#stale[@]} -eq 3 ]] && echo "clear the gate's copy of ${stale[1]} at ${stale[2]}"
    printf 'no-mistakes'
    printf ' %q' "${args[@]}"
    echo
    return
  fi
  if ! git remote get-url no-mistakes >/dev/null 2>&1; then
    no-mistakes init >&2
  fi
  if [[ ${#stale[@]} -ne 3 ]]; then
    local tree code=0
    tree=$(git rev-parse 'HEAD^{tree}')
    no-mistakes "${args[@]}" || code=$?
    record_gate "$tree" "$code"
    return "$code"
  fi

  local gate_dir=${stale[0]} branch=${stale[1]} copy=${stale[2]} code=0
  local tag="refs/tags/no-mistakes-abandoned/$branch/$copy" none=${copy//?/0}
  git --git-dir="$gate_dir" rev-parse -q --verify "$tag" >/dev/null ||
    git --git-dir="$gate_dir" update-ref --no-deref "$tag" "$copy" "$none"
  git --git-dir="$gate_dir" update-ref --no-deref -d "refs/heads/$branch" "$copy"
  echo "gate: this branch rewrote the gate's copy at ${copy:0:8}; archived it as $tag" >&2
  local tree
  tree=$(git rev-parse 'HEAD^{tree}')
  no-mistakes "${args[@]}" || code=$?
  record_gate "$tree" "$code"
  # A run that never started leaves the gate's copy as no-mistakes last saw it.
  if [[ "$code" != 0 ]] && ! git --git-dir="$gate_dir" rev-parse -q --verify "refs/heads/$branch" >/dev/null; then
    git --git-dir="$gate_dir" update-ref --no-deref "refs/heads/$branch" "$copy" "$none"
  fi
  return "$code"
}

# Folds one gate fix commit into the commit it fixes: a fixup rebase that moves
# <commit> to just after <target>, run with keel itself as the sequence
# editor so it needs no program named on the command line. Only for history no
# remote holds, from a clean tree, and only when the branch's final tree comes
# out unchanged; anything else is refused or undone.
fold() {
  local commit target head
  [[ $# -eq 2 ]] || die "usage: keel fold <gate-fix-commit> <target-commit>"
  commit=$(resolve_commit "$1") || die "not a commit: $1"
  target=$(resolve_commit "$2") || die "not a commit: $2"
  git symbolic-ref -q HEAD >/dev/null || die "not on a branch"
  [[ "$commit" != "$target" ]] || die "a commit cannot fold into itself"
  git merge-base --is-ancestor "$target" "$commit" || die "$2 is not an ancestor of $1"
  git merge-base --is-ancestor "$commit" HEAD || die "$1 is not on this branch"
  git rev-parse -q --verify "$target^" >/dev/null || die "cannot fold into a root commit"
  [[ -z "$(git status --porcelain --untracked-files=no)" ]] || die "the tree has uncommitted changes"
  # The gate's own remote holds a copy of every gated branch, and `keel
  # gate` takes a folded branch back, so only the other remotes count.
  # shellcheck disable=SC2143 # grep -q would end the pipe early under pipefail
  [[ -z "$(git branch -r --contains "$target" --format='%(refname)' | grep -v '^refs/remotes/no-mistakes/')" ]] ||
    die "$2 is already on a remote; a fold would rewrite pushed history"

  head=$(git rev-parse HEAD)
  if ! GIT_SEQUENCE_EDITOR="$(readlink -f "$0") __fold-todo $commit $target" \
    git rebase -q -i "$target^" >&2; then
    git rebase --abort >/dev/null 2>&1 || true
    die "the fold did not apply cleanly; the branch is back at ${head:0:8}"
  fi
  if ! git diff --quiet "$head" HEAD; then
    git reset -q --hard "$head"
    die "the fold changed the branch's final tree; the branch is back at ${head:0:8}"
  fi
  echo "folded ${commit:0:8} into ${target:0:8}; tree unchanged, head ${head:0:8} -> $(git rev-parse --short=8 HEAD)"
}

# Prints the full sha of a commit name. Resolved before `^{commit}` is applied,
# since a `:/message` search would otherwise read the suffix as part of it.
resolve_commit() {
  local sha
  sha=$(git rev-parse -q --verify "$1") || return 1
  git rev-parse -q --verify "$sha^{commit}"
}

# The sequence editor fold runs: in the rebase todo at $3, drops <commit>'s
# pick and puts it back as a fixup straight after <target>'s.
fold_todo() {
  local commit="$1" target="$2" todo="$3" out line sha full
  out=$(mktemp)
  while IFS= read -r line; do
    sha=$(awk '$1 == "pick" || $1 == "p" { print $2 }' <<<"$line")
    full=""
    if [[ -n "$sha" ]]; then
      full=$(git rev-parse -q --verify "$sha^{commit}" || true)
    fi
    if [[ "$full" == "$commit" ]]; then
      continue
    fi
    echo "$line" >>"$out"
    if [[ "$full" == "$target" ]]; then
      echo "fixup $commit" >>"$out"
    fi
  done <"$todo"
  mv "$out" "$todo"
}

# Prints "<gate dir> <branch> <sha>" when the gate's private copy of the current
# branch is a head this branch has since rewritten, by a fold or a rebase, and so
# has to be cleared before the gate takes the branch again. no-mistakes refuses
# to replace such a copy itself: it proves survival by per-commit patch identity,
# which every fold changes, so a deliberate rewrite reads as lost work. The proof
# that holds here is that the branch's own reflog held the copy, so none of its
# commits live only in the gate. A run still in flight, or gate fixes not yet
# brought back by `no-mistakes axi sync --recover`, keep the copy, because those
# are the cases no-mistakes guards and reports itself.
stale_gate_copy() {
  local branch gate_dir copy head status entry held=0
  branch=$(git symbolic-ref -q --short HEAD) || return 0
  gate_dir=$(git remote get-url no-mistakes 2>/dev/null) || return 0
  [[ -d "$gate_dir" ]] || return 0
  git --git-dir="$gate_dir" symbolic-ref -q "refs/heads/$branch" >/dev/null && return 0
  copy=$(git --git-dir="$gate_dir" rev-parse -q --verify "refs/heads/$branch^{commit}") || return 0
  head=$(git rev-parse HEAD)
  [[ "$copy" != "$head" ]] || return 0
  git merge-base --is-ancestor "$copy" "$head" 2>/dev/null && return 0

  while read -r entry; do
    if git merge-base --is-ancestor "$copy" "$entry" 2>/dev/null; then
      held=1
      break
    fi
  done < <(git log -g --format=%H "refs/heads/$branch" -- 2>/dev/null || true)
  [[ "$held" == 1 ]] || return 0

  status=$(no-mistakes axi status 2>/dev/null) || return 0
  case "$(toon_field run status <<<"$status")" in
  pending | running) return 0 ;;
  esac
  case "$(toon_field branch_sync state <<<"$status")" in
  pipeline_owned | push_in_progress) return 0 ;;
  esac
  echo "$gate_dir $branch $copy"
}

# Prints one field of a top-level block in no-mistakes' TOON output on stdin.
toon_field() {
  awk -v block="$1:" -v field="  $2:" '
    $0 == block { inside = 1; next }
    /^[^ ]/ { inside = 0 }
    inside && index($0, field) == 1 { sub(field " *", ""); gsub(/"/, ""); print; exit }
  '
}

# Linear, over its GraphQL API, for any workspace. The repository picks the
# workspace: ~/.config/keel/linear maps an origin glob to a team key and the
# name of the env var holding that workspace's API key, matched like a pack's
# `match`. A pack's `linear` file still names the team for the repositories it
# owns. The key goes to curl in a header file, never on a command line, and no
# message ever prints it.
LINEAR_URL="${KEEL_LINEAR_URL:-https://api.linear.app/graphql}"
LINEAR_MAP="$HOME/.config/keel/linear"

# Prints "<team> <key env>" for the repository at $1, or dies saying what to
# add or set.
linear_target() {
  local dir="$1" remote glob team env pack line
  remote=$(git -C "$dir" remote get-url origin 2>/dev/null) ||
    die "no origin remote in $dir, so no Linear workspace maps to it"
  if [[ -f "$LINEAR_MAP" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ -z "${line// /}" || "$line" == \#* ]] && continue
      read -r glob team env _ <<<"$line"
      # shellcheck disable=SC2053 # the pattern is a glob on purpose
      if [[ "$remote" == $glob ]]; then
        pack=$(pack_for "$dir")
        if [[ -n "$pack" && -f "$pack/linear" ]]; then
          team=$(tr -d '[:space:]' <"$pack/linear")
        fi
        [[ -n "$team" && -n "$env" ]] || die "malformed line in ~/.config/keel/linear: $line"
        echo "$team $env"
        return
      fi
    done <"$LINEAR_MAP"
  fi
  die "no Linear workspace maps to origin $remote; add a line to ~/.config/keel/linear: <origin glob> <team key> <API key env var>"
}

# Sends the JSON request body in file $1 and prints the response's data, or
# dies with Linear's errors. LINEAR_ENV names the env var holding the key.
linear_call() {
  local body="$1" hdr out key
  key="${!LINEAR_ENV:-}"
  [[ -n "$key" ]] || die "$LINEAR_ENV is not set"
  hdr=$(mktemp)
  chmod 600 "$hdr"
  printf 'Authorization: %s\nContent-Type: application/json\n' "$key" >"$hdr"
  out=$(curl -sS -H @"$hdr" --data @"$body" "$LINEAR_URL" 2>&1) || {
    rm -f "$hdr"
    die "Linear did not answer: ${out//$key/<key>}"
  }
  rm -f "$hdr"
  if ! jq -e . >/dev/null 2>&1 <<<"$out"; then
    die "Linear answered with something other than JSON: ${out//$key/<key>}"
  fi
  if jq -e '.errors | length > 0' >/dev/null <<<"$out"; then
    die "Linear refused the request: $(jq -r '[.errors[].message] | join("; ")' <<<"$out")"
  fi
  jq '.data' <<<"$out"
}

# gql <query> [jq args building the variables object...] -> data. The
# variables come from `jq -n` with the given args, so Markdown read with
# --rawfile is never escaped by hand.
gql() {
  local query="$1" vars body data
  shift
  vars=$(jq -n "$@" '$ARGS.named') || die "could not build the request"
  body=$(mktemp)
  jq -n --arg q "$query" --argjson v "$vars" '{query: $q, variables: $v}' >"$body"
  data=$(linear_call "$body") || {
    rm -f "$body"
    exit 1
  }
  rm -f "$body"
  echo "$data"
}

issue_uuid() {
  gql 'query($id: String!) { issue(id: $id) { id } }' --arg id "$1" | jq -er '.issue.id' ||
    die "no issue $1"
}

# Prints "<team id> <workspace name>" for the team key $1.
team_id() {
  gql 'query($key: String!) { teams(filter: {key: {eq: $key}}) { nodes { id } } organization { name } }' --arg key "$1" |
    jq -er '"\(.teams.nodes[0].id // error) \(.organization.name)"' || die "no team $1 in this workspace"
}

project_id() {
  gql 'query($name: String!) { projects(filter: {name: {eq: $name}}) { nodes { id } } }' --arg name "$1" |
    jq -er '.projects.nodes[0].id' || die "no project named $1"
}

need_file() {
  [[ -n "${2:-}" ]] || die "$1 needs a value"
  [[ -f "$2" ]] || die "no such file: $2"
}

linear() {
  local verb="${1:-}" target team
  shift || true
  [[ -n "$verb" ]] || die "usage: keel linear team|get|search|create|update|comment|relate|project ..."
  target=$(linear_target "$PWD") || exit 1
  team=${target% *}
  LINEAR_ENV=${target#* }
  case "$verb" in
  team) echo "$team" ;;
  get) linear_get "$@" ;;
  create) linear_create "$team" "$@" ;;
  update) linear_update "$@" ;;
  comment) linear_comment "$@" ;;
  relate) linear_relate "$@" ;;
  project) linear_project "$team" "$@" ;;
  search) linear_search "$team" "$@" ;;
  *) die "unknown linear verb: $verb" ;;
  esac
}

linear_get() {
  [[ $# -eq 1 ]] || die "usage: keel linear get <ID>"
  gql 'query($id: String!) { issue(id: $id) {
      identifier title description url branchName priority
      state { name type } team { key } project { name } parent { identifier title }
      relations { nodes { type relatedIssue { identifier title state { name } } } }
      inverseRelations { nodes { type issue { identifier title state { name } } } }
      comments { nodes { body createdAt user { name } } } } }' --arg id "$1" | jq '.issue'
}

linear_create() {
  local team="$1" title="" body="" project="" blocked=() tid org pid data id url
  shift
  while (($#)); do
    case "$1" in
    --title) title="${2:-}" && shift 2 ;;
    --body) body="${2:-}" && shift 2 ;;
    --project) project="${2:-}" && shift 2 ;;
    --blocked-by) blocked+=("${2:-}") && shift 2 ;;
    *) die "usage: keel linear create --title <t> --body <file> [--project <name>] [--blocked-by <ID>]..." ;;
    esac
  done
  [[ -n "$title" ]] || die "create needs --title"
  need_file --body "$body"
  read -r tid org <<<"$(team_id "$team")" || exit 1
  [[ -n "$tid" ]] || exit 1
  local args=(--arg teamId "$tid" --arg title "$title" --rawfile description "$body")
  if [[ -n "$project" ]]; then
    pid=$(project_id "$project") || exit 1
    args+=(--arg projectId "$pid")
  fi
  data=$(gql 'mutation($teamId: String!, $title: String!, $description: String, $projectId: String) {
      issueCreate(input: {teamId: $teamId, title: $title, description: $description, projectId: $projectId}) {
        issue { id identifier url } } }' "${args[@]}") || exit 1
  id=$(jq -r '.issueCreate.issue.identifier' <<<"$data")
  url=$(jq -r '.issueCreate.issue.url' <<<"$data")
  local b
  for b in "${blocked[@]}"; do
    linear_relate "$b" blocks "$id" >/dev/null || exit 1
  done
  echo "$id $url (team $team, workspace $org)"
}

linear_update() {
  local id="${1:-}" state="" body="" sid
  [[ -n "$id" && "$id" != --* ]] || die "usage: keel linear update <ID> [--state <name>] [--body <file>]"
  shift
  while (($#)); do
    case "$1" in
    --state) state="${2:-}" && shift 2 ;;
    --body) body="${2:-}" && shift 2 ;;
    *) die "usage: keel linear update <ID> [--state <name>] [--body <file>]" ;;
    esac
  done
  [[ -n "$state" || -n "$body" ]] || die "update needs --state or --body"
  local args=(--arg id "$id")
  if [[ -n "$state" ]]; then
    sid=$(gql 'query($id: String!) { issue(id: $id) { team { states { nodes { id name } } } } }' --arg id "$id" |
      jq -er --arg s "$state" '.issue.team.states.nodes[] | select(.name == $s) | .id') ||
      die "no state named $state in $id's team"
    args+=(--arg stateId "$sid")
  fi
  if [[ -n "$body" ]]; then
    need_file --body "$body"
    args+=(--rawfile description "$body")
  fi
  gql 'mutation($id: String!, $stateId: String, $description: String) {
      issueUpdate(id: $id, input: {stateId: $stateId, description: $description}) {
        issue { identifier state { name } } } }' "${args[@]}" |
    jq -r '.issueUpdate.issue | "\(.identifier) \(.state.name)"'
}

linear_comment() {
  [[ $# -eq 3 && "$2" == --body ]] || die "usage: keel linear comment <ID> --body <file>"
  need_file --body "$3"
  local uuid
  uuid=$(issue_uuid "$1") || exit 1
  gql 'mutation($issueId: String!, $body: String!) { commentCreate(input: {issueId: $issueId, body: $body}) {
      comment { url } } }' --arg issueId "$uuid" --rawfile body "$3" | jq -r '.commentCreate.comment.url'
}

linear_relate() {
  [[ $# -eq 3 && "$2" == blocks ]] || die "usage: keel linear relate <A> blocks <B>"
  local a b
  a=$(issue_uuid "$1") || exit 1
  b=$(issue_uuid "$3") || exit 1
  gql 'mutation($a: String!, $b: String!) { issueRelationCreate(input: {issueId: $a, relatedIssueId: $b, type: blocks}) {
      success } }' --arg a "$a" --arg b "$b" >/dev/null || exit 1
  echo "$1 blocks $3"
}

# A project's description is capped at 255 characters by Linear, so the long
# text goes in its content.
linear_project() {
  local team="$1" verb="${2:-}" name="${3:-}" summary="" body="" tid pid
  [[ -n "$verb" && -n "$name" ]] || die "usage: keel linear project create|get|update <name> [--summary <s>] [--body <file>]"
  shift 3
  while (($#)); do
    case "$1" in
    --summary) summary="${2:-}" && shift 2 ;;
    --body) body="${2:-}" && shift 2 ;;
    *) die "usage: keel linear project create|get|update <name> [--summary <s>] [--body <file>]" ;;
    esac
  done
  ((${#summary} <= 255)) || die "--summary is ${#summary} characters; Linear allows 255. Put the rest in --body"
  [[ -z "$body" ]] || need_file --body "$body"
  local args=()
  [[ -n "$summary" ]] && args+=(--arg description "$summary")
  [[ -n "$body" ]] && args+=(--rawfile content "$body")
  case "$verb" in
  get)
    gql 'query($name: String!) { projects(filter: {name: {eq: $name}}) { nodes {
        name description content url state
        issues { nodes { identifier title state { name } } } } } }' --arg name "$name" |
      jq -e '.projects.nodes[0]' || die "no project named $name"
    ;;
  create)
    tid=$(team_id "$team") || exit 1
    tid=${tid%% *}
    gql 'mutation($name: String!, $teamId: String!, $description: String, $content: String) {
        projectCreate(input: {name: $name, teamIds: [$teamId], description: $description, content: $content}) {
          project { name url } } }' "${args[@]}" --arg name "$name" --arg teamId "$tid" |
      jq -r '.projectCreate.project | "\(.name) \(.url)"'
    ;;
  update)
    [[ -n "$summary" || -n "$body" ]] || die "project update needs --summary or --body"
    pid=$(project_id "$name") || exit 1
    gql 'mutation($id: String!, $description: String, $content: String) {
        projectUpdate(id: $id, input: {description: $description, content: $content}) {
          project { name url } } }' "${args[@]}" --arg id "$pid" |
      jq -r '.projectUpdate.project | "\(.name) \(.url)"'
    ;;
  *) die "unknown project verb: $verb" ;;
  esac
}

# The team's open issues whose title contains the text, for a duplicate check
# before filing.
linear_search() {
  local team="$1"
  shift
  [[ $# -ge 1 ]] || die "usage: keel linear search <text>"
  gql 'query($team: String!, $text: String!) { issues(first: 50, filter: {
      team: {key: {eq: $team}}, title: {containsIgnoreCase: $text},
      state: {type: {nin: ["completed", "canceled"]}} }) {
      nodes { identifier title url state { name } } } }' --arg team "$team" --arg text "$*" |
    jq -r '.issues.nodes[] | "\(.identifier)\t\(.state.name)\t\(.title)\t\(.url)"'
}

# A pack's template replaces the core's of the same name rather than merging
# into it, like provision, so a pack can put its own sections where they belong
# instead of appending them.
template_for() {
  local name="$1" dir="$2" pack
  [[ "$name" =~ ^[a-z0-9-]+$ ]] || die "not a template name: $name"
  pack=$(pack_for "$dir")
  if [[ -n "$pack" && -f "$pack/templates/$name.md" ]]; then
    cat "$pack/templates/$name.md"
  elif [[ -f "$TEMPLATES_DIR/$name.md" ]]; then
    cat "$TEMPLATES_DIR/$name.md"
  else
    die "no template named $name; \`keel template\` lists them"
  fi
}

template_names() {
  local pack f
  pack=$(pack_for "$1")
  for f in "$TEMPLATES_DIR"/*.md ${pack:+"$pack"/templates/*.md}; do
    [[ -f "$f" ]] || continue
    basename "$f" .md
  done | sort -u
}

# Runs: every task a playbook routes is a run, recorded outside the tree in
# $RUNS_DIR/<tree-key>/status.json so a run never shows as work in the tree
# and never blocks a pool return by accident. docs/status.md is the schema.

# The tree's absolute path with every / and . turned into -, as Claude Code
# names its project folders: readable, and stable for the tree's life.
tree_key() {
  local p="${1%/}"
  echo "${p//[\/.]/-}"
}

# The tree a path belongs to: its git toplevel, else the path itself.
tree_of() {
  git -C "$1" rev-parse --show-toplevel 2>/dev/null || (cd "$1" && pwd -P)
}

run_dir() { echo "$RUNS_DIR/$(tree_key "$1")"; }

now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# Writes JSON on stdin to $1 through a temporary file in the same directory
# and a rename, so a reader polling the file only ever sees a whole one.
write_atomic() {
  local tmp
  tmp=$(mktemp "$(dirname "$1")/.status.XXXXXX")
  cat >"$tmp" && mv -f "$tmp" "$1"
}

# Applies a jq filter to the run's status.json, stamping updated_at.
run_update() { # run_update <run dir> <jq filter> [jq args...]
  local dir="$1" filter="$2"
  shift 2
  jq --arg now "$(now)" "$@" "($filter) | .updated_at = \$now" "$dir/status.json" | write_atomic "$dir/status.json"
}

# Prints "<playbook> <state> at step <n>" when the tree has an active or
# paused run, and fails when it has none.
run_holding() {
  local dir
  dir=$(run_dir "$1")
  [[ -f "$dir/status.json" ]] || return 1
  jq -er 'select(.state == "active" or .state == "paused")
    | "\(.playbook) \(.state) at step \(.current // "none")"' "$dir/status.json"
}

run_start() {
  local playbook="" goal="" steps="" replace=0 contract="" allow_passing=0 tree branch dir held done_cmd=""
  while (($#)); do
    case "$1" in
    --playbook) playbook="${2:-}" && shift 2 ;;
    --goal) goal="${2:-}" && shift 2 ;;
    --steps) steps="${2:-}" && shift 2 ;;
    --replace) replace=1 && shift ;;
    --contract) contract="${2:-}" && shift 2 ;;
    --allow-passing) allow_passing=1 && shift ;;
    *) die "usage: keel run start --playbook <name> --goal <text> --steps <file> [--contract <file> [--allow-passing]] [--replace]" ;;
    esac
  done
  [[ -n "$playbook" && -n "$goal" ]] || die "run start needs --playbook and --goal"
  [[ -f "$steps" ]] || die "run start needs --steps <file>, one step per line"
  tree=$(tree_of "$PWD")
  dir=$(run_dir "$tree")
  if [[ "$replace" == 0 ]] && held=$(run_holding "$tree"); then
    die "run $held already holds $tree; finish it with \`keel run stop\`, or start with --replace"
  fi
  # A done check that already passes would let the run end before any work.
  if [[ -n "$contract" ]]; then
    done_cmd=$(contract_check "$contract") || exit 1
    if [[ "$(run_done_check "$tree" "$done_cmd" | head -1)" == 0 && "$allow_passing" == 0 ]]; then
      die "the contract's done check already passes, so it cannot tell when the work is done; make it fail today, or pass --allow-passing"
    fi
  fi
  if held=$(run_holding "$tree"); then
    [[ "$replace" == 1 ]] || die "run $held already holds $tree; finish it with \`keel run stop\`, or start with --replace"
    run_archive "$dir" stopped "replaced by a new run"
  elif [[ -f "$dir/status.json" ]]; then
    # A run that ended on its own, by giving up or by its budget, is still
    # listed for its Attention; a new run moves it to the archive as it is.
    run_archive "$dir" "$(jq -r .state "$dir/status.json")" "$(jq -r '.note // ""' "$dir/status.json")"
  fi
  branch=$(git -C "$tree" symbolic-ref -q --short HEAD 2>/dev/null || echo "")
  mkdir -p "$dir"
  # One step per non-empty line, a leading "1. " or "- " dropped.
  jq -n --arg tree "$tree" --arg branch "$branch" --arg playbook "$playbook" --arg goal "$goal" \
    --arg now "$(now)" --rawfile steps "$steps" '{
      version: 1, tree: $tree, branch: $branch, playbook: $playbook, goal: $goal,
      state: "active",
      steps: [$steps | split("\n")[] | sub("^\\s*([0-9]+[.)]|[-*])\\s+"; "") | select(test("\\S"))
              | {title: ., state: "pending", reason: null}],
      current: null, started_at: $now, updated_at: $now, stale: false,
      attention: 0, done_check: null, verifier: null, gate: null, contract_hash: null
    }' | write_atomic "$dir/status.json"
  [[ "$(jq '.steps | length' "$dir/status.json")" -gt 0 ]] || {
    rm -rf "$dir"
    die "the steps file holds no steps"
  }
  if [[ -n "$contract" ]]; then
    cp "$contract" "$dir/contract.md"
    run_update "$dir" '.contract_hash = $h' --arg h "$(sha256sum "$dir/contract.md" | cut -d' ' -f1)"
  fi
  echo "run $playbook started in $tree${contract:+, held to its contract}"
}

# The run's folder for the tree at --tree, else the current tree, when it has
# an active or paused run.
held_run_dir() { # held_run_dir <tree or ""> [any]: "any" also takes a run that has ended
  local tree="$1" dir
  tree=$(tree_of "${tree:-$PWD}")
  dir=$(run_dir "$tree")
  if [[ "${2:-}" == any ]]; then
    [[ -f "$dir/status.json" ]] || die "no run in $tree"
  else
    run_holding "$tree" >/dev/null || die "no active run in $tree"
  fi
  echo "$dir"
}

run_step() {
  local n="${1:-}" state="${2:-}" reason="${3:-}" dir count
  [[ "$n" =~ ^[0-9]+$ ]] || die "usage: keel run step <n> doing|done|skip <reason>"
  case "$state" in
  doing | done) [[ -z "$reason" ]] || die "only skip takes a reason" ;;
  skip) [[ -n "$reason" ]] || die "a skipped step needs its reason: keel run step $n skip <reason>" ;;
  *) die "usage: keel run step <n> doing|done|skip <reason>" ;;
  esac
  dir=$(held_run_dir "") || exit 1
  count=$(jq '.steps | length' "$dir/status.json")
  ((n >= 1 && n <= count)) || die "the run has steps 1 to $count"
  # A step being worked on is the current one; finishing or skipping it moves
  # current to the first step still open. Touching a paused run resumes it.
  run_update "$dir" '
    .state = "active"
    | .steps[$i].state = (if $s == "skip" then "skipped" else $s end)
    | .steps[$i].reason = (if $s == "skip" then $r else null end)
    | .current = (if $s == "doing" then $i + 1
        else ([.steps | to_entries[] | select(.value.state == "pending" or .value.state == "doing") | .key + 1] | first) end)' \
    --argjson i "$((n - 1))" --arg s "$state" --arg r "$reason"
  if [[ "$state" == skip ]]; then
    log_row "$dir" "skipped step $n" "$reason" "$(jq -r ".steps[$((n - 1))].title" "$dir/status.json")" "skipped" yes
  fi
}

# Moves a run's folder to the archive, ended, so status no longer lists it.
run_archive() { # run_archive <run dir> <state> <note>
  local dir="$1" state="$2" note="$3" started dest
  run_update "$dir" '.state = $s | .note = (if $n == "" then null else $n end) | .ended_at = .updated_at' \
    --arg s "$state" --arg n "$note"
  started=$(jq -r .started_at "$dir/status.json")
  dest="$RUNS_DIR/archive/$(basename "$dir")/$started"
  # Two runs can start in the same second, as with --replace; neither archive
  # may overwrite the other.
  while [[ -e "$dest" ]]; do dest="$dest+"; done
  mkdir -p "$(dirname "$dest")"
  mv "$dir" "$dest"
}

run_stop() {
  local state="${1:-}" note="" tree="" dir
  case "$state" in
  done | stopped | failed) shift ;;
  *) die "usage: keel run stop done|stopped|failed [--note <text>] [--tree <path>]" ;;
  esac
  while (($#)); do
    case "$1" in
    --note) note="${2:-}" && shift 2 ;;
    --tree) tree="${2:-}" && shift 2 ;;
    *) die "usage: keel run stop done|stopped|failed [--note <text>] [--tree <path>]" ;;
    esac
  done
  dir=$(held_run_dir "$tree" any) || exit 1
  run_archive "$dir" "$state" "$note"
  echo "run $state; archived"
}

# Pauses the run; a resume note on stdin, when given, goes into its folder.
run_pause() {
  local dir
  dir=$(held_run_dir "") || exit 1
  if [[ ! -t 0 ]]; then
    cat >"$dir/resume.md.tmp" && mv -f "$dir/resume.md.tmp" "$dir/resume.md"
    [[ -s "$dir/resume.md" ]] || rm -f "$dir/resume.md"
  fi
  run_update "$dir" '.state = "paused"'
  echo "run paused; folder $dir"
}

run() {
  local verb="${1:-}"
  shift || true
  mkdir -p "$RUNS_DIR"
  case "$verb" in
  start) run_start "$@" ;;
  step) run_step "$@" ;;
  stop) run_stop "$@" ;;
  pause) run_pause "$@" ;;
  decide) run_decide "$@" ;;
  dir) held_run_dir "${1:-}" any ;;
  *) die "usage: keel run start|step|stop|pause|decide|dir ..." ;;
  esac
}

# Prints every run not yet archived, or the one for path, as a JSON array: an
# active or paused run, or one that gave up or ran out of budget, which stays
# listed for its Attention until `keel run stop` archives it.
# Reads files only, never git or treehouse, so treetop can poll it: staleness
# comes from the cache `keel sweep` refreshes.
status() {
  local json=0 path=""
  while (($#)); do
    case "$1" in
    --json) json=1 && shift ;;
    *) path="$1" && shift ;;
    esac
  done
  [[ "$json" == 1 ]] || die "usage: keel status --json [path]"
  local files=("$RUNS_DIR"/*/status.json)
  if [[ ! -e "${files[0]}" ]]; then
    echo "[]"
    return
  fi
  if [[ -n "$path" ]]; then
    path=$(cd "$path" 2>/dev/null && pwd -P) || die "no such directory: $path"
  fi
  [[ -f "$STALE_FILE" ]] || STALE_FILE=/dev/null
  jq -n --arg path "$path" --rawfile stale "$STALE_FILE" '
    ($stale | split("\n") | map(select(. != ""))) as $stale
    | [inputs
       | .stale = (.state == "active" and (.tree as $t | $stale | index($t) != null))
       | select(.tree as $t | $path == "" or $path == $t or ($path | startswith($t + "/")))]' \
    "${files[@]}"
}

# Rewrites the stale cache for this pool: an active run is stale when its tree
# is leased with no live process in it, which treehouse records.
refresh_stale() {
  local pool kept
  pool=$(treehouse status --json 2>/dev/null) || return 0
  mkdir -p "$(dirname "$STALE_FILE")"
  touch "$STALE_FILE"
  kept=$(grep -vxFf <(jq -r '.[].path' <<<"$pool") "$STALE_FILE" || true)
  {
    [[ -n "$kept" ]] && echo "$kept"
    jq -r '.[] | select(.status == "leased" and (.processes | length == 0)) | .path' <<<"$pool" |
      while IFS= read -r p; do
        if [[ "$(jq -r .state "$(run_dir "$p")/status.json" 2>/dev/null)" == active ]]; then echo "$p"; fi
      done
  } | write_atomic "$STALE_FILE"
}

# Contracts: a run started with a contract is held to its done check by the
# Stop hook, logs its decisions to decisions.tsv, and counts what needs the
# user's attention. trust/contract.md is the template.

# Prints the value of one `key:` line from the contract's header block, the
# lines before the first blank one.
contract_field() { # contract_field <file> <key>
  awk -v k="$2" '
    /^[[:space:]]*$/ { exit }
    index($0, k ":") == 1 { sub("^" k ":[[:space:]]*", ""); print; exit }
  ' "$1"
}

# A budget such as 4h, 90m, 1h30m or 45s, in seconds.
budget_seconds() {
  local b="$1" total=0 n u
  [[ "$b" =~ ^([0-9]+[hms])+$ ]] || return 1
  while [[ "$b" =~ ^([0-9]+)([hms])(.*)$ ]]; do
    n=${BASH_REMATCH[1]} u=${BASH_REMATCH[2]} b=${BASH_REMATCH[3]}
    case "$u" in
    h) total=$((total + n * 3600)) ;;
    m) total=$((total + n * 60)) ;;
    s) total=$((total + n)) ;;
    esac
  done
  echo "$total"
}

# Checks a contract and prints its done command, or dies saying what is wrong.
contract_check() {
  local file="$1" done_cmd budget grants g
  [[ -f "$file" ]] || die "no such contract: $file"
  done_cmd=$(contract_field "$file" "done")
  [[ -n "$done_cmd" ]] || die "the contract has no done: line; it needs a command whose exit 0 means done"
  budget=$(contract_field "$file" budget)
  if [[ -n "$budget" ]]; then
    budget_seconds "$budget" >/dev/null || die "budget: $budget is not a duration such as 4h, 90m or 1h30m"
  fi
  grants=$(contract_field "$file" grants)
  for g in ${grants//,/ }; do
    case "$g" in
    none | commit | push | draft-pr) ;;
    *) die "grants: $g is not none, or one of commit, push, draft-pr" ;;
    esac
  done
  echo "$done_cmd"
}

# Runs the done command from the tree's root with a timeout; prints its exit
# code on the first line and the last 40 lines of its output after it.
run_done_check() { # run_done_check <tree> <command>
  local out code=0
  out=$(cd "$1" && timeout "${KEEL_DONE_TIMEOUT:-600}" bash -c "$2" 2>&1) || code=$?
  echo "$code"
  tail -n 40 <<<"$out"
}

# One row in the run's decisions.tsv: time, step, decision, why, evidence,
# result, attention. Tabs and newlines in a field become spaces, so a row
# stays a row. The attention count in status.json follows the flagged rows.
log_row() { # log_row <run dir> <decision> <why> <evidence> <result> <attention: yes|"">
  local dir="$1" step
  step=$(jq -r '.current // ""' "$dir/status.json")
  {
    printf '%s' "$(now)"
    printf '\t%s' "$step" "${2//[$'\t\n']/ }" "${3//[$'\t\n']/ }" "${4//[$'\t\n']/ }" "${5//[$'\t\n']/ }" "$6"
    printf '\n'
  } >>"$dir/decisions.tsv"
  run_update "$dir" '.attention = $n' --argjson n "$(awk -F'\t' '$7 == "yes"' "$dir/decisions.tsv" | wc -l)"
}

run_decide() {
  local decision="${1:-}" why="" evidence="" result="" attention="" dir
  [[ -n "$decision" && "$decision" != --* ]] || die 'usage: keel run decide "<decision>" --why <text> --evidence <ref> [--result <text>] [--attention]'
  shift
  while (($#)); do
    case "$1" in
    --why) why="${2:-}" && shift 2 ;;
    --evidence) evidence="${2:-}" && shift 2 ;;
    --result) result="${2:-}" && shift 2 ;;
    --attention) attention=yes && shift ;;
    *) die 'usage: keel run decide "<decision>" --why <text> --evidence <ref> [--result <text>] [--attention]' ;;
    esac
  done
  [[ -n "$why" && -n "$evidence" ]] || die "a decision needs --why and --evidence"
  dir=$(held_run_dir "") || exit 1
  log_row "$dir" "$decision" "$why" "$evidence" "$result" "$attention"
}

# The Stop hook. For an active run with a contract in the session's tree, the
# turn ends only once the done check passes, the agent has written giveup.md,
# or the budget is spent; otherwise it is blocked with the failing output. A
# contract changed since the run started is never run.
hook_stop() {
  local input cwd tree dir done_cmd code out tail budget started elapsed
  input=$(cat)
  cwd=$(jq -r .cwd <<<"$input")
  tree=$(tree_of "$cwd" 2>/dev/null) || return 0
  dir=$(run_dir "$tree")
  [[ -f "$dir/contract.md" && -f "$dir/status.json" ]] || return 0
  [[ "$(jq -r .state "$dir/status.json")" == active ]] || return 0

  if [[ "$(sha256sum "$dir/contract.md" | cut -d' ' -f1)" != "$(jq -r .contract_hash "$dir/status.json")" ]]; then
    log_row "$dir" "contract changed mid-run" "its hash no longer matches the one recorded at start" "$dir/contract.md" "blocked; done check not run" yes
    jq -n --arg r "The run's contract at $dir/contract.md changed after the run started, so its done check was not run. Put the contract back as it was approved, or stop and ask for a new run." \
      '{decision: "block", reason: $r}'
    return 0
  fi

  done_cmd=$(contract_field "$dir/contract.md" "done")
  out=$(run_done_check "$tree" "$done_cmd")
  code=$(head -1 <<<"$out")
  tail=$(tail -n +2 <<<"$out")
  run_update "$dir" '.done_check = {exit: $code, passed: ($code == 0), head: $head, at: $now, tail: $tail}' \
    --argjson code "$code" --arg head "$(git -C "$tree" rev-parse HEAD 2>/dev/null)" --arg tail "$tail"
  if [[ "$code" == 0 ]]; then
    log_row "$dir" "done check" "the Stop hook runs it before the turn ends" "$done_cmd" "pass" ""
    return 0
  fi
  log_row "$dir" "done check" "the Stop hook runs it before the turn ends" "$done_cmd" "fail, exit $code" yes

  if [[ -f "$dir/giveup.md" ]]; then
    log_row "$dir" "gave up" "$(head -c 300 "$dir/giveup.md")" "$dir/giveup.md" "stopped" yes
    run_update "$dir" '.state = "stopped" | .reason = "gave up"'
    return 0
  fi
  budget=$(contract_field "$dir/contract.md" budget)
  if [[ -n "$budget" ]]; then
    started=$(date -d "$(jq -r .started_at "$dir/status.json")" +%s)
    elapsed=$(($(date +%s) - started))
    if ((elapsed >= $(budget_seconds "$budget"))); then
      log_row "$dir" "budget spent" "$budget passed with the done check still failing" "$done_cmd" "failed; giveup.md asked for" yes
      run_update "$dir" '.state = "failed" | .reason = "budget"'
      jq -n --arg r "The run's budget of $budget is spent and the done check still fails, so the run has failed. Write $dir/giveup.md saying where it got to and why it is stuck." \
        '{systemMessage: $r}'
      return 0
    fi
  fi
  jq -n --arg r "The done check \`$done_cmd\` fails (exit $code): $tail

Keep going, or write $dir/giveup.md saying why you are stuck." '{decision: "block", reason: $r}'
}

# Records a keel-verifier's verdict in the run holding the tree at $1, from
# its last message: the line `VERDICT: pass` or `VERDICT: fail`, its findings
# after it. A verifier that ends without the line fails. Only this hook writes
# the verdict, so the session that did the work never records its own pass.
record_verdict() { # record_verdict <cwd> <last message>
  local tree dir verdict findings
  tree=$(tree_of "$1" 2>/dev/null) || return 0
  dir=$(run_dir "$tree")
  [[ "$(jq -r .state "$dir/status.json" 2>/dev/null)" == active ]] || return 0
  verdict=$(grep -oE '^VERDICT: (pass|fail)' <<<"$2" | tail -1 | cut -d' ' -f2 || true)
  findings=$(sed -n '/^VERDICT: /,$p' <<<"$2" | tail -n +2 | head -c 4000)
  if [[ -z "$verdict" ]]; then
    verdict=fail
    findings="the verifier ended without a VERDICT line"
  fi
  run_update "$dir" '.verifier = {verdict: $v, tree: $t, at: $now, findings: $f}' \
    --arg v "$verdict" --arg t "$(git -C "$tree" rev-parse 'HEAD^{tree}')" --arg f "$findings"
  log_row "$dir" "verifier: $verdict" "a fresh keel-verifier ran the checks" "HEAD^{tree} $(git -C "$tree" rev-parse --short=12 'HEAD^{tree}')" "$verdict" "$([[ "$verdict" == pass ]] || echo yes)"
}

# Records the gate's verdict in the run holding this tree, against the tree
# the gate ran on, with no-mistakes' run id.
record_gate() { # record_gate <tree hash> <exit code>
  local top dir verdict id
  top=$(git rev-parse --show-toplevel)
  dir=$(run_dir "$top")
  [[ "$(jq -r .state "$dir/status.json" 2>/dev/null)" == active ]] || return 0
  verdict=$([[ "$2" == 0 ]] && echo pass || echo fail)
  id=$(no-mistakes axi status 2>/dev/null | toon_field run id || true)
  run_update "$dir" '.gate = {verdict: $v, tree: $t, at: $now, run_id: $id}' --arg v "$verdict" --arg t "$1" --arg id "$id"
  log_row "$dir" "gate: $verdict" "keel gate ran no-mistakes" "run ${id:-unknown}" "$verdict" "$([[ "$verdict" == pass ]] || echo yes)"
}

# Learning: `keel reflect triage` applies /reflect's twice rule and level
# ordering to the synthesizer's findings, so the rule lives in code, not in a
# model's reading of a skill. seen.tsv is private to the machine and never
# committed: it holds what was seen once, not what was acted on.
SEEN_FILE="$STATE_DIR/learning/seen.tsv"

# The levels a lesson can land at, strongest first.
LEVELS='["rails","check","playbook","skill","rule"]'

# Reads findings as a JSON array on stdin, each
#   {key, finding, level, why_not_stronger, evidence, edit}
# and prints {accepted, held, rejected}:
#   rejected  a finding with no evidence, an unknown level, or a level below
#             rails with no reason the stronger levels do not fit;
#   held      a finding whose key this machine has not seen before, which is
#             recorded in seen.tsv;
#   accepted  a finding seen at least once before, strongest level first.
# A "no playbook fits" shape is a finding at level playbook like any other.
reflect_triage() {
  local session="${1:-}" findings seen out
  findings=$(cat)
  jq -e 'type == "array"' >/dev/null 2>&1 <<<"$findings" || die "reflect triage reads a JSON array of findings on stdin"
  mkdir -p "$(dirname "$SEEN_FILE")"
  touch "$SEEN_FILE"
  seen=$(cut -f2 "$SEEN_FILE" | jq -R . | jq -s .)
  out=$(mktemp "$STATE_DIR/learning/.triage.XXXXXX")
  jq --argjson levels "$LEVELS" --argjson seen "$seen" '
    def why_rejected:
      if (.evidence // "") == "" then "no evidence"
      elif (.level as $l | $levels | index($l)) == null then "unknown level \(.level // "none")"
      elif .level != "rails" and (.why_not_stronger // "") == "" then "no reason the stronger levels do not fit"
      elif (.key // "") == "" then "no key"
      elif (.key | test("^[a-z0-9][a-z0-9:._-]*$") | not) then "a key that is not a slug"
      else null end;
    map(. + {rejected_because: why_rejected}) as $all
    | {
        rejected: [$all[] | select(.rejected_because != null)],
        held: [$all[] | select(.rejected_because == null and (.key as $k | $seen | index($k) == null)) | del(.rejected_because)],
        accepted: [$all[] | select(.rejected_because == null and (.key as $k | $seen | index($k) != null)) | del(.rejected_because)]
          | sort_by(.level as $l | $levels | index($l))
      }' <<<"$findings" >"$out" || die "could not read the findings"
  # Every finding not rejected is recorded as seen, so a held one is accepted
  # the next time a reflection finds it.
  jq -r --arg now "$(now)" --arg s "$session" '(.held + .accepted)[] | [$now, .key, (.finding // "" | gsub("[\t\n]"; " ")), $s] | @tsv' \
    "$out" >>"$SEEN_FILE"
  cat "$out"
  rm -f "$out"
}

reflect() {
  case "${1:-}" in
  triage)
    shift
    reflect_triage "$@"
    ;;
  *) die "usage: keel reflect triage [session id] < findings.json" ;;
  esac
}

cmd="${1:-}"
[[ -n "$cmd" ]] || {
  usage >&2
  exit 1
}
shift

case "$cmd" in
claude) CLAUDE_CONFIG_DIR="$HOME/.keel/claude" exec claude "$@" ;;
pack) pack_for "${1:-$PWD}" ;;
base) base_for "${1:-$PWD}" ;;
protected) protected_for "${1:-$PWD}" ;;
provision) provision "${1:-$PWD}" ;;
sweep) sweep "${1:-}" ;;
run) run "$@" ;;
status) status "$@" ;;
reflect) reflect "$@" ;;
gate) gate "$@" ;;
linear) linear "$@" ;;
template)
  if [[ -n "${1:-}" ]]; then template_for "$1" "${2:-$PWD}"; else template_names "$PWD"; fi
  ;;
fold) fold "$@" ;;
__fold-todo) fold_todo "$@" ;;
e2e) e2e "$@" ;;
stack)
  case "${1:-}" in
  up) shift && stack_up "$PWD" "$@" ;;
  down) stack_down "$PWD" ;;
  status) stack_status "$PWD" ;;
  release) stack_release "$PWD" ;;
  *) die "usage: keel stack up [args] | down | status | release" ;;
  esac
  ;;
hook)
  case "${1:-}" in
  context) hook_context ;;
  worktree-create) hook_worktree_create ;;
  worktree-remove) hook_worktree_remove ;;
  subagent-stop) hook_subagent_stop ;;
  git-guard) hook_git_guard ;;
  stop) hook_stop ;;
  *) die "unknown hook: ${1:-}" ;;
  esac
  ;;
help | -h | --help) usage ;;
*)
  usage >&2
  exit 1
  ;;
esac
